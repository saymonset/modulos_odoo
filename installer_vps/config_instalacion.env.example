# ============================================================
# config_instalacion.env — Configuración de instalación por cliente (VPS)
#
# Este archivo lo leen los scripts 0_*..5_* de installer_vps/.
# Copia este ejemplo a config_instalacion.env y rellena los datos
# del cliente. El tarball portable ya lleva un config pre-llenado.
# ============================================================

# Slug del cliente (minúsculas, sin espacios, sin acentos)
CLIENTE_SLUG="torteralevis"

# Dominio base. Los FQDN del stack son: <servicio>.<CLIENTE_SLUG>.<DOMINIO_BASE>
# ej: torteralevis.integraia.lat, chatwoot.torteralevis.integraia.lat
DOMINIO_BASE="integraia.lat"

# ¿Incluir el bloque lead (odoo_leads 28069/28072) en el nginx? (yes/no)
INCLUIR_BLOQUE_LEAD="yes"

# Repositorios GitHub (se clonan por SSH, no se empaquetan)
GITHUB_SKELETON_URL="git@github.com:saymonset/odoo19-skeleton.git"
GITHUB_MODULOS_URL="git@github.com:saymonset/modulos_odoo.git"
SKELETON_BRANCH="main"
MODULOS_BRANCH="main"

# Ambientes a crear: "prod" o "prod lead"
AMBIENTES="prod"

# Identidad git local (commits de odoo en los clones)
GIT_NAME="saymonset"
GIT_EMAIL="saymon_set@hotmail.com"

# UID del usuario odoo en el host (los contenedores usan 1001:1001)
ODOO_UID=1001

# Base de datos Odoo (debe coincidir con docker-compose.odoo.yml)
DB_NAME="dbodoo19"

# Zona horaria del stack
TZ="America/Santiago"

# ------------------------------------------------------------
# Datos del cliente para el stack (.env de odoo19-skeleton)
# El agente debe preguntarlos al usuario durante la instalación.
# ------------------------------------------------------------

# FQDN raíz del cliente (es <CLIENTE_SLUG>.<DOMINIO_BASE>)
DOMINIO_CLIENTE="torteralevis.integraia.lat"

# SMTP del cliente (el stack lo usa para correos y monitores)
SMTP_HOST="mail.integraia.lat"
SMTP_PORT="465"
SMTP_USER="admin@torteralevis.integraia.lat"
SMTP_PASSWORD=""
SMTP_FROM="admin@torteralevis.integraia.lat"