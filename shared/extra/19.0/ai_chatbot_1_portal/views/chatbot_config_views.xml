<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- chatbot.config                               -->
        <!-- ============================================ -->

        <record id="view_chatbot_config_list" model="ir.ui.view">
            <field name="name">chatbot.config.list</field>
            <field name="model">chatbot.config</field>
            <field name="arch" type="xml">
                <list string="Configuraciones de negocio">
                    <field name="name"/>
                    <field name="cta_url"/>
                    <field name="output_instagram"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_chatbot_config_form" model="ir.ui.view">
            <field name="name">chatbot.config.form</field>
            <field name="model">chatbot.config</field>
            <field name="arch" type="xml">
                <form string="Configuración de negocio">
                    <header>
                        <button name="action_recargar_todo_desde_rag" type="object"
                                string="Sincronizar todo desde RAG"
                                class="btn-primary"
                                confirm="Lee n8n_vectors, actualiza rol/contacto/base de conocimiento, regenera las intenciones, (re)crea los flujos base del catálogo, detecta y activa los flujos que aplican a tu negocio (con sus pasos) y (re)genera los Chatwoot Mappings automáticamente. Si la tabla n8n_vectors está vacía o no existe, no se cambia nada: verás un aviso y deberás ejecutar primero la ingestión RAG en n8n. ¿Continuar?"/>
                        <button name="action_activar_flujos" type="object"
                                string="Activar solo los flujos marcados (no usa RAG)"
                                class="btn-secondary"
                                confirm="NO lee el RAG. Activa únicamente los flujos marcados en 'Flujos de este cliente' más el flujo por defecto, archiva el resto, y (re)genera sus pasos y mappings. Si el campo 'Flujos de este cliente' está vacío, se archivarán todos y solo quedará activo el flujo por defecto. ¿Continuar?"/>
                        <button name="action_refrescar_desde_rag" type="object"
                                string="Refrescar solo intenciones (no toca flujos)"
                                class="btn-secondary"
                                confirm="Actualiza solo rol/contacto/base de conocimiento e intenciones desde n8n_vectors. NO modifica flujos ni Chatwoot Mappings. Si la tabla n8n_vectors está vacía o no existe, no se cambia nada: verás un aviso. ¿Continuar?"/>
                        <button name="action_regenerar_menu" type="object"
                                string="Regenerar menú según rol"
                                class="btn-secondary"
                                confirm="Regenera el menú (encabezado + etiquetas de opciones) desde el rol del negocio usando IA, sin re-sincronizar RAG. Los flujos marcados en 'Flujos de este cliente' determinan las opciones. ¿Continuar?"/>
                    </header>
                    <sheet>
                        <group string="Onboarding (primera vez)">
                            <div class="alert alert-info" role="alert">
                                <b>Cómo poner un cliente a funcionar:</b><br/>
                                1️⃣ Sube a la carpeta de Google Drive del
                                cliente sus documentos reales: precios,
                                catálogo, horarios, políticas. (Nada del prompt
                                del bot).<br/>
                                2️⃣ En n8n, ejecuta el workflow "Sistema RAG
                                standar" para cargarlos.<br/>
                                3️⃣ Pulsa <b>"Sincronizar todo desde RAG"</b>:
                                Odoo arma el menú, las intenciones y activa los
                                flujos solito.<br/>
                                4️⃣ Prueba por WhatsApp: "menu" y una pregunta
                                de precios. El bot debe responder con la
                                información, SIN pedirte datos.<br/>
                                5️⃣ ¿Te falta un flujo especial (ej. citas por
                                seguro, un trámite propio)? Créalo en
                                Chatbot → Flujos, márcalo abajo en "Flujos de
                                este cliente" y pulsa <b>"Activar solo los
                                flujos marcados"</b>.
                                ⚠️ OJO: ese botón archiva todos los flujos que
                                NO marques.
                            </div>
                        </group>
                        <group string="Diagnóstico">
                            <field name="diagnostico" widget="text" readonly="1"/>
                            <button name="action_desvincular_flujos_contenido"
                                    type="object"
                                    string="Desvincular flujos de contenido"
                                    class="btn-secondary"
                                    invisible="intenciones_contenido_con_flujo == 0"
                                    confirm="Quita el 'Flujo que dispara' de las intenciones de contenido para que el bot responda precios/servicios con el RAG y no dispare capturas ante preguntas informativas. ¿Continuar?"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="brand_name"/>
                            <field name="attribution_enabled"/>
                            <field name="attribution_text"
                                   invisible="attribution_enabled == False"/>
                            <field name="cta_url"/>
                            <field name="output_instagram"/>
                            <field name="active"/>
                        </group>
                        <group string="Contenido del agente">
                            <field name="role" widget="text"/>
                            <field name="contacto" widget="text"/>
                            <field name="bloque_conocimiento" widget="text"/>
                        </group>
                        <group string="Flujos de este cliente">
                            <field name="flujo_ids" widget="many2many_tags"/>
                        </group>
                        <notebook>
                            <page string="Intenciones">
                                <div class="alert alert-info" role="alert">
                                    <b>Tips:</b> las intenciones de
                                    <b>contenido</b> (precios, servicios,
                                    productos, medidas) <b>NO deben tener
                                    "Flujo que dispara"</b>: se responden
                                    consultando la base de conocimiento (RAG).
                                    El flujo solo se activa en intenciones de
                                    <b>ACCIÓN</b> (agendar, confirmar, imagen,
                                    otra consulta) o cuando el usuario confirma
                                    que quiere cotizar/agendar/comprar.
                                </div>
                                <field name="intencion_ids">
                                    <list editable="bottom">
                                        <field name="nombre"/>
                                        <field name="keywords"/>
                                        <field name="prioridad"/>
                                        <field name="tipo_pregunta"/>
                                        <field name="es_menu"/>
                                        <field name="flow_id"/>
                                        <field name="es_auto_rag"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chatbot_config" model="ir.actions.act_window">
            <field name="name">Configuraciones de negocio</field>
            <field name="res_model">chatbot.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Acción para crear/actualizar el cliente desde el RAG sin abrir una
             config previa (n8n_vectors es la única fuente de verdad). -->
        <record id="action_crear_cliente_desde_rag" model="ir.actions.server">
            <field name="name">Crear cliente desde RAG</field>
            <field name="model_id" ref="model_chatbot_config"/>
            <field name="binding_model_id" ref="model_chatbot_config"/>
            <field name="state">code</field>
            <field name="code">result = env['chatbot.config'].sudo()._crear_cliente_desde_rag_por_accion()</field>
        </record>

        <!-- ============================================ -->
        <!-- chatbot.intencion                            -->
        <!-- ============================================ -->

        <record id="view_chatbot_intencion_list" model="ir.ui.view">
            <field name="name">chatbot.intencion.list</field>
            <field name="model">chatbot.intencion</field>
            <field name="arch" type="xml">
                <list string="Intenciones del chatbot">
                    <field name="config_id"/>
                    <field name="nombre"/>
                    <field name="prioridad"/>
                    <field name="tipo_pregunta"/>
                    <field name="es_menu"/>
                    <field name="flow_id"/>
                </list>
            </field>
        </record>

        <record id="view_chatbot_intencion_form" model="ir.ui.view">
            <field name="name">chatbot.intencion.form</field>
            <field name="model">chatbot.intencion</field>
            <field name="arch" type="xml">
                <form string="Intención del chatbot">
                    <sheet>
                        <group>
                            <field name="config_id"/>
                            <field name="nombre"/>
                            <field name="prioridad"/>
                            <field name="tipo_pregunta"/>
                            <field name="flow_id"/>
                            <field name="es_menu"/>
                        </group>
                        <group string="Clasificación y respuestas">
                            <field name="keywords" widget="text"/>
                            <field name="output_largo" widget="text"/>
                            <field name="output_corto" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chatbot_intencion" model="ir.actions.act_window">
            <field name="name">Intenciones del chatbot</field>
            <field name="res_model">chatbot.intencion</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>