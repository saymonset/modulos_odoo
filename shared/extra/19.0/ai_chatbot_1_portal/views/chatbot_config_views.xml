<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- chatbot.config                               -->
        <!-- ============================================ -->

        <record id="view_chatbot_config_list" model="ir.ui.view">
            <field name="name">chatbot.config.list</field>
            <field name="model">chatbot.config</field>
            <field name="arch" type="xml">
                <list string="Configuraciones de negocio">
                    <field name="name"/>
                    <field name="cta_url"/>
                    <field name="output_instagram"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_chatbot_config_form" model="ir.ui.view">
            <field name="name">chatbot.config.form</field>
            <field name="model">chatbot.config</field>
            <field name="arch" type="xml">
                <form string="Configuración de negocio">
                    <header>
                        <button name="action_crear_cliente_desde_rag" type="object"
                                string="Crear/Actualizar cliente desde RAG"
                                class="btn-primary"
                                confirm="Se crea (o actualiza) la configuración del cliente a partir de la tabla n8n_vectors, se regeneran las intenciones, se detectan y activan los flujos con sus pasos, y se (re)crean los Chatwoot Mappings. ¿Continuar?"/>
                        <button name="action_recargar_todo_desde_rag" type="object"
                                string="Recargar intenciones, flujos y mappings"
                                class="btn-secondary"
                                confirm="Se leen n8n_vectors, se regeneran las intenciones (es_auto_rag), se detectan y activan los flujos aplicables con sus pasos, y se (re)crean los Chatwoot Mappings. Los flujos no detectados se archivarán. ¿Continuar?"/>
                        <button name="action_activar_flujos" type="object"
                                string="Activar flujos de esta configuración"
                                class="btn-secondary"/>
                        <button name="action_refrescar_desde_rag" type="object"
                                string="Refrescar intenciones desde RAG"
                                class="btn-secondary"
                                confirm="Se regenerarán las intenciones de contenido (es_auto_rag) desde la tabla n8n_vectors y se actualizará la Base de conocimiento. ¿Continuar?"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="brand_name"/>
                            <field name="attribution_enabled"/>
                            <field name="attribution_text"
                                   invisible="attribution_enabled == False"/>
                            <field name="cta_url"/>
                            <field name="output_instagram"/>
                            <field name="active"/>
                        </group>
                        <group string="Contenido del agente">
                            <field name="role" widget="text"/>
                            <field name="contacto" widget="text"/>
                            <field name="bloque_conocimiento" widget="text"/>
                        </group>
                        <group string="Flujos activos">
                            <field name="flujo_ids" widget="many2many_tags"/>
                        </group>
                        <notebook>
                            <page string="Intenciones">
                                <field name="intencion_ids">
                                    <list editable="bottom">
                                        <field name="nombre"/>
                                        <field name="keywords"/>
                                        <field name="prioridad"/>
                                        <field name="tipo_pregunta"/>
                                        <field name="es_menu"/>
                                        <field name="flow_id"/>
                                        <field name="es_auto_rag"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chatbot_config" model="ir.actions.act_window">
            <field name="name">Configuraciones de negocio</field>
            <field name="res_model">chatbot.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Acción para crear/actualizar el cliente desde el RAG sin abrir una
             config previa (n8n_vectors es la única fuente de verdad). -->
        <record id="action_crear_cliente_desde_rag" model="ir.actions.server">
            <field name="name">Crear cliente desde RAG</field>
            <field name="model_id" ref="model_chatbot_config"/>
            <field name="binding_model_id" ref="model_chatbot_config"/>
            <field name="state">code</field>
            <field name="code">result = env['chatbot.config'].sudo()._crear_cliente_desde_rag_por_accion()</field>
        </record>

        <!-- ============================================ -->
        <!-- chatbot.intencion                            -->
        <!-- ============================================ -->

        <record id="view_chatbot_intencion_list" model="ir.ui.view">
            <field name="name">chatbot.intencion.list</field>
            <field name="model">chatbot.intencion</field>
            <field name="arch" type="xml">
                <list string="Intenciones del chatbot">
                    <field name="config_id"/>
                    <field name="nombre"/>
                    <field name="prioridad"/>
                    <field name="tipo_pregunta"/>
                    <field name="es_menu"/>
                    <field name="flow_id"/>
                </list>
            </field>
        </record>

        <record id="view_chatbot_intencion_form" model="ir.ui.view">
            <field name="name">chatbot.intencion.form</field>
            <field name="model">chatbot.intencion</field>
            <field name="arch" type="xml">
                <form string="Intención del chatbot">
                    <sheet>
                        <group>
                            <field name="config_id"/>
                            <field name="nombre"/>
                            <field name="prioridad"/>
                            <field name="tipo_pregunta"/>
                            <field name="flow_id"/>
                            <field name="es_menu"/>
                        </group>
                        <group string="Clasificación y respuestas">
                            <field name="keywords" widget="text"/>
                            <field name="output_largo" widget="text"/>
                            <field name="output_corto" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_chatbot_intencion" model="ir.actions.act_window">
            <field name="name">Intenciones del chatbot</field>
            <field name="res_model">chatbot.intencion</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>