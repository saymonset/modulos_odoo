<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================== -->
        <!-- PASOS ESTÁNDAR DE CONTACTO - flujo_agendamiento_precios -->
        <!-- Nombre -> Teléfono -> Consentimiento WhatsApp      -->
        <!-- ================================================== -->

        <!-- Paso 1: Nombre completo -->
        <record id="flujo_agendamiento_precios_paso_nombre" model="chatbot.paso">
            <field name="flujo_id" ref="flujo_agendamiento_precios"/>
            <field name="secuencia">1</field>
            <field name="nombre_interno">nombre_completo</field>
            <field name="nombre_mostrar">Nombre completo</field>
            <field name="tipo_dato">text</field>
            <field name="campo_destino">nombre_completo</field>
            <field name="es_requerido">True</field>
            <field name="es_paso_telefono">False</field>
            <field name="mensaje_prompt">¿Cuál es tu nombre completo?</field>
            <field name="mensaje_error">Por favor, indícame tu nombre completo para continuar.</field>
        </record>

        <!-- Paso 2: Teléfono -->
        <record id="flujo_agendamiento_precios_paso_telefono" model="chatbot.paso">
            <field name="flujo_id" ref="flujo_agendamiento_precios"/>
            <field name="secuencia">2</field>
            <field name="nombre_interno">telefono</field>
            <field name="nombre_mostrar">Teléfono</field>
            <field name="tipo_dato">text</field>
            <field name="campo_destino">telefono</field>
            <field name="es_requerido">True</field>
            <field name="es_paso_telefono">True</field>
            <field name="mensaje_prompt">Para poder contactarte, ¿me compartes tu número de teléfono?</field>
            <field name="mensaje_error">El número no parece válido. Escríbelo completo, por ejemplo: 0412 1234567.</field>
        </record>

        <!-- Paso 3: Consentimiento WhatsApp -->
        <record id="flujo_agendamiento_precios_paso_consentimiento" model="chatbot.paso">
            <field name="flujo_id" ref="flujo_agendamiento_precios"/>
            <field name="secuencia">3</field>
            <field name="nombre_interno">consentimiento_whatsapp</field>
            <field name="nombre_mostrar">Consentimiento WhatsApp</field>
            <field name="tipo_dato">boolean</field>
            <field name="campo_destino">consentimiento_whatsapp</field>
            <field name="es_requerido">True</field>
            <field name="es_paso_telefono">False</field>
            <field name="mensaje_prompt">Para enviarte recordatorios e información por WhatsApp, necesito tu autorización. ¿Me dices 'sí' o 'no'?</field>
            <field name="mensaje_error">Por favor, responde 'sí' o 'no'.</field>
        </record>

    </data>
</odoo>