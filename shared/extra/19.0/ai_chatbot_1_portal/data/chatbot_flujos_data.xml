<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ============================================ -->
        <!-- FLUJOS - Los nombres coinciden con n8n        -->
        <!-- ============================================ -->
        
        <!-- Flujo 1: Agendamiento Directo -->
        <record id="flujo_agendamiento_directo" model="chatbot.flujo">
            <field name="name">flujo_agendamiento_directo</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario quiere agendar directamente una cita, turno o reserva.</field>
            <field name="palabras_clave">cita,citas,agenda,agendar,agendamiento,reservar,reserva,turno,turnos,cupo,horario</field>
        </record>
        
        <!-- Flujo 2: Agendamiento Precios -->
        <record id="flujo_agendamiento_precios" model="chatbot.flujo">
            <field name="name">flujo_agendamiento_precios</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario pregunta por precios, costos, tarifas o cotizaciones.</field>
            <field name="palabras_clave">precio,precios,costo,costos,cuanto,valor,tarifa,tarifas,cotizacion,cotizaciones,plan,planes</field>
        </record>
        
        <!-- Flujo 3: Agendamiento Servicios -->
        <record id="flujo_agendamiento_servicios" model="chatbot.flujo">
            <field name="name">flujo_agendamiento_servicios</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario pregunta por servicios, procedimientos o paquetes ofrecidos.</field>
            <field name="palabras_clave">servicio,servicios,procedimientos,procedimiento,paquete,paquetes,tratamiento,tratamientos</field>
        </record>
        
        <!-- Flujo 4: Ventas -->
        <record id="flujo_ventas" model="chatbot.flujo">
            <field name="name">flujo_ventas</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario quiere comprar, pedir, encargar o adquirir productos del negocio.</field>
            <field name="palabras_clave">venta,ventas,vender,compra,comprar,pedido,pedidos,carrito,producto,productos,tienda,panaderia,pan,restaurante,domicilio,delivery,retail</field>
        </record>
        
        <!-- Flujo 5: Otra Consulta -->
        <record id="flujo_agendamiento_otra_consulta" model="chatbot.flujo">
            <field name="name">flujo_agendamiento_otra_consulta</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario tiene otra consulta o solicitud no cubierta por los demás flujos.</field>
            <field name="palabras_clave">consulta,dudas,duda,pregunta,preguntas,informacion,solicitud,asesoria,orientacion</field>
        </record>
        
        <!-- Flujo 6: Flujo por defecto -->
        <record id="flujo_agendamiento_default" model="chatbot.flujo">
            <field name="name">flujo_agendamiento_default</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">Flujo de respaldo cuando ninguna otra intención aplica.</field>
        </record>
        
        <!-- Flujo 7: Citas con Medios Propios -->
        <record id="flujo_citas_medios_propios" model="chatbot.flujo">
            <field name="name">flujo_citas_medios_propios</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">Cita médica pagada por el propio paciente (sin seguro).</field>
            <field name="palabras_clave">clinica,clinicas,hospital,hospitales,salud,medico,medicos,doctor,doctores,consultorio,medicina</field>
        </record>
        
        <!-- Flujo 8: Citas con Seguro Médico -->
        <record id="flujo_citas_seguro" model="chatbot.flujo">
            <field name="name">flujo_citas_seguro</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">Cita médica cubierta por un seguro médico o aseguradora.</field>
            <field name="palabras_clave">seguro,seguros,aseguradora,poliza,seguro medico,plan de salud,ips,sanitas,sura,coomeva,eps</field>
        </record>
        
        <!-- Flujo 9: Resultados de Laboratorio -->
        <record id="flujo_resultados_laboratorio" model="chatbot.flujo">
            <field name="name">flujo_resultados_laboratorio</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario consulta o requiere resultados de exámenes de laboratorio.</field>
            <field name="palabras_clave">laboratorio,laboratorio clinico,examen,examenes,sangre,biometria,glicemia,resultados de laboratorio,mis resultados</field>
        </record>
        
        <!-- Flujo 10: Resultados de Imágenes -->
        <record id="flujo_resultados_imagenes" model="chatbot.flujo">
            <field name="name">flujo_resultados_imagenes</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
            <field name="descripcion_intencion">El usuario consulta o presenta resultados de estudios de imagenología.</field>
            <field name="palabras_clave">imagenologia,imagenes diagnosticas,rayos x,ecografia,mamografia,rmn,tomografia,radiografia,densitometria</field>
        </record>
        
    </data>
</odoo>