<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Análisis de ventas: columna Total USD en la lista -->
    <record id="sale_report_view_tree_usd_bcv" model="ir.ui.view">
        <field name="name">sale.report.view.list.usd.bcv</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="price_subtotal" position="after">
                <field name="currency_usd_id" column_invisible="True"/>
                <field name="price_subtotal_usd" string="Untaxed Total USD" widget="monetary"
                       options="{'currency_field': 'currency_usd_id'}"
                       sum="Sum of Untaxed Total USD" optional="show"/>
            </field>
            <field name="price_total" position="after">
                <field name="price_total_usd" string="Total USD" widget="monetary"
                       options="{'currency_field': 'currency_usd_id'}"
                       sum="Sum of Total USD" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Análisis de ventas: medidas USD en el pivot -->
    <record id="sale_report_pivot_usd_bcv" model="ir.ui.view">
        <field name="name">sale.report.pivot.usd.bcv</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="price_subtotal_usd" type="measure"/>
                <field name="price_total_usd" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
