<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Montaje del autocompletado por teléfono en la pantalla Detalles del checkout -->
    <template id="address_autofill_mount" inherit_id="website_sale.address" name="Address Autofill Mount">
        <xpath expr="//form[@name='address_form']" position="before">
            <owl-component name="bcv_rate_update_venezuela.AddressAutofill"/>
        </xpath>
    </template>

    <!-- Elimina "¿Ya tiene una cuenta? / Sign in" del checkout anónimo: redunda con el login del header -->
    <template id="address_remove_signin" inherit_id="website_sale.address" name="Remove Redundant Sign-in Prompt">
        <xpath expr="//div[hasclass('o_address_signin')]" position="replace"/>
    </template>
</odoo>