<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista form única con dos modos según state -->
    <record id="price_tier_import_wizard_form" model="ir.ui.view">
        <field name="name">price.tier.import.wizard.form</field>
        <field name="model">price.tier.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <!-- Paso 1: Seleccionar archivo -->
                <group invisible="state != 'choose'">
                    <group string="Instrucciones">
                        <p class="text-muted">
                            Seleccione un archivo Excel (.xlsx) con las siguientes columnas en la
                            primera fila (encabezados):
                            <br/>
                            <strong>default_code</strong>, <strong>tier_type</strong>,
                            <strong>price_usd</strong>
                            <br/><br/>
                            <em>tier_type</em> debe ser: retail, wholesale o mercadolibre.
                            <br/>
                            El sistema calculará automáticamente price_ves y price_cop según las
                            tasas BCV y COP vigentes.
                        </p>
                    </group>
                    <group>
                        <field name="file_data" filename="file_name" string="Archivo Excel"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_import" string="Importar" type="object"
                                class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </group>

                <!-- Paso 2: Resultados -->
                <group invisible="state != 'done'">
                    <group string="Resultados de la Importación">
                        <field name="log_line_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'created'"
                                       decoration-warning="status == 'updated'"
                                       decoration-danger="status == 'error'"/>
                                <field name="default_code"/>
                                <field name="product_name"/>
                                <field name="tier_type"/>
                                <field name="price_usd" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       optional="hide"/>
                                <field name="price_ves" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       optional="hide"/>
                                <field name="price_cop" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       optional="hide"/>
                                <field name="message"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button string="Cerrar" class="btn-primary" special="cancel"/>
                    </footer>
                </group>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="price_tier_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Importar Precios por Nivel</field>
        <field name="res_model">price.tier.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_state': 'choose'}</field>
    </record>

    <!-- Entrada de menú -->
    <menuitem id="price_tier_import_menu"
              name="Importar desde Excel"
              parent="sale.product_menu_catalog"
              action="price_tier_import_wizard_action"
              sequence="55"/>

</odoo>
