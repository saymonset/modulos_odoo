<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <!-- MAPEOS POR DEFECTO Chatwoot
         Un mapping por cada flujo de chatbot cargado por ai_chatbot_1_portal.
         - flow_id: vincula al flujo interno (chatbot.flujo).
         - equipo_asignado: valor canónico del selection que espera el round-robin.
         - routing_key: nombre del flujo tal como lo envía n8n (equipo_asignado).
         - Los campos de Chatwoot (inbox_id, agent_id, agent_email, tags) se
           dejan VACIOS: cada cliente los completa según su propio agente.
         noupdate="1": se crean solo la primera vez; las personalizaciones de
           cada cliente nunca se sobrescriben al actualizar el módulo. -->

    <record id="mapping_agendamiento_directo" model="chatwoot.mapping">
        <field name="name">Agendamiento Directo (default)</field>
        <field name="flow_id" ref="ai_chatbot_1_portal.flujo_agendamiento_directo"/>
        <field name="equipo_asignado">Agendamiento_Directo</field>
        <field name="routing_key">flujo_agendamiento_directo</field>
    </record>

