<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_normalized_pos_usd" model="ir.ui.view">
        <field name="name">product.template.form.normalized.pos.usd</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="cop_show_fields" invisible="1"/>
                <field name="currency_usd_id" invisible="1"/>
                <span class="mx-2" style="font-weight: bold;">o</span>
                <field name="list_price_usd"
                       class="oe_inline"
                       widget="monetary"
                       options="{'currency_field': 'currency_usd_id'}"/>
                <field name="currency_cop_id" invisible="1"/>
                <span class="mx-2" style="font-weight: bold;" invisible="not cop_show_fields">o</span>
                <field name="list_price_cop"
                       class="oe_inline"
                       widget="monetary"
                       options="{'currency_field': 'currency_cop_id'}"
                       invisible="not cop_show_fields"/>
                <span class="text-muted small mx-1" invisible="not cop_show_fields">COP</span>
            </field>
        </field>
    </record>

</odoo>
