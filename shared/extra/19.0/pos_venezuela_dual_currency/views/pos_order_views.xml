<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Total USD en el formulario de la orden de venta -->
    <record id="view_pos_order_form_inherit_usd_total" model="ir.ui.view">
        <field name="name">pos.order.form.usd.total</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_total']/field[@name='amount_total']" position="after">
                <field name="amount_total_usd" class="h3" widget="monetary"/>
                <field name="bcv_rate_value" string="Tasa BCV" widget="float" options="{'precision': 4}"/>
            </xpath>
        </field>
    </record>

    <!-- Total USD en la lista de órdenes de venta -->
    <record id="view_pos_order_list_inherit_usd_total" model="ir.ui.view">
        <field name="name">pos.order.list.usd.total</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="amount_total_usd" sum="Total USD" widget="monetary" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Total USD como medida en el pivot de órdenes de venta -->
    <record id="view_pos_order_pivot_inherit_usd_total" model="ir.ui.view">
        <field name="name">pos.order.pivot.usd.total</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_pivot"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="amount_total_usd" type="measure"/>
                <field name="bcv_rate_value" type="measure" invisible="1"/>
            </field>
        </field>
    </record>

</odoo>
