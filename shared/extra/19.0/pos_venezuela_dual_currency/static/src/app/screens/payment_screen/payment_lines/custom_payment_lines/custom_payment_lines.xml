<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_venezuela_dual_currency.CustomPaymentLines">
        <div class="currency-converter d-flex flex-column gap-2 mb-1">
            <!-- Header: título + tasa -->
            <div class="d-flex align-items-center justify-content-between currency-converter-header">
                <span class="fw-bold small text-uppercase converter-title">Convertir</span>
                <span t-if="state.rateLoaded" class="text-muted rate">
                    <t t-esc="formatDecimal(state.rate)"/> Bs/US$
                </span>
            </div>

            <!-- Moneda destino: toggle -->
            <div class="d-flex currency-toggle">
                <t t-foreach="currencies" t-as="currency" t-key="currency.id">
                    <button class="btn flex-fill text-truncate"
                        t-att-class="{
                            'btn-primary': state.selectedCurrency === currency.id,
                            'btn-secondary': state.selectedCurrency !== currency.id,
                        }"
                        t-on-click="() => this.selectCurrency(currency.id)">
                        <t t-esc="currency.symbol"/> <t t-esc="currency.label"/>
                    </button>
                </t>
            </div>

            <!-- Input del monto -->
            <div class="input-group">
                <span class="input-group-text fw-bold bg-light"><t t-esc="activeCurrency.symbol"/></span>
                <input type="text" class="form-control text-end fw-bold"
                    inputmode="decimal"
                    placeholder="Monto a pagar"
                    aria-label="Monto a pagar"
                    t-att-value="state.inputAmount"
                    t-on-input="(ev) => this.onInputChange(ev)"
                    t-on-keydown="(ev) => this.onKeydown(ev)"
                    t-on-focus="() => state.inputFocused = true"
                    t-on-blur="() => state.inputFocused = false"/>
                <button class="btn btn-primary"
                    t-att-disabled="!canApply"
                    t-on-click="() => this.applyToPaymentLine()">
                    <i class="fa fa-check"/>
                </button>
            </div>

            <!-- Conversión preview -->
            <div t-if="displayConversion" class="conversion-preview d-flex justify-content-center align-items-center gap-1 flex-wrap text-muted">
                <t t-foreach="displayConversion" t-as="conv" t-key="conv.label">
                    <span t-if="conv_index > 0" class="mx-1">=</span>
                    <span class="fw-bold"><t t-esc="conv.label"/> <t t-esc="formatDecimal(conv.value)"/></span>
                </t>
            </div>

            <!-- Acciones rápidas + hint de método destino -->
            <div t-if="props.paymentLines and props.paymentLines.length > 0" class="d-flex flex-column gap-1">
                <div class="d-flex quick-actions">
                    <button class="btn btn-outline-primary flex-fill"
                        t-on-click="() => this.applyExactRemaining()">
                        <i class="fa fa-check-circle me-1"/> Total exacto
                    </button>
                    <button class="btn btn-outline-secondary flex-fill"
                        t-att-disabled="!state.inputAmount"
                        t-on-click="() => this.clearInput()">
                        <i class="fa fa-eraser me-1"/> Limpiar
                    </button>
                </div>
                <div class="payment-target-hint text-center text-muted">
                    <t t-if="selectedPaymentName">
                        Monto para: <strong><t t-esc="selectedPaymentName"/></strong>
                    </t>
                    <t t-else="">
                        Selecciona un método de pago
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
